# Auto-detect text files while defaulting text EOL to LF (never force binary files as text)
* text=auto eol=lf

# Kotlin, Java, Gradle & Android Source / Config Files
*.kt          text eol=lf
*.kts         text eol=lf
*.java        text eol=lf
*.xml         text eol=lf
*.gradle      text eol=lf
*.properties  text eol=lf
*.toml        text eol=lf
*.json        text eol=lf
*.pro         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sh          text eol=lf
*.base64      text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.gitkeep      text eol=lf
.env*         text eol=lf

# Windows scripts
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Compiled Android Packages, Libraries & Bytecode (MUST remain binary)
*.apk         binary
*.aab         binary
*.ap_         binary
*.aar         binary
*.jar         binary
*.dex         binary
*.so          binary
*.zip         binary

# Keystores & Signing Credentials
*.keystore    binary
*.jks         binary
*.p12         binary

# Images, Icons & Fonts
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.gif         binary
*.ico         binary
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary
*.pdf         binary
